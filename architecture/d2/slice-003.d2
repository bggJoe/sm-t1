direction: down

# SLICE-003 業務 D2：Admin 審核申請
# 範圍：查詢 PENDING 清單 + approve/reject 審核動作
# 架構立場（DEC-019）：admin 模組為薄 Portal 層；業務語意由 registration 模組擁有
# 不在此圖：JWT filter chain 攔截行為（見 cross-cutting-jwt.d2）

admin_actor: Admin {
  shape: person
}

admin_module: "admin 模組 (Portal)" {
  style.fill: "#fffbe6"
  style.stroke: "#c8a000"

  app_controller: "AdminApplicationController [Presentation / ProtectedEndpoint]" {
    style.fill: "#b0c4de"
  }
}

registration_module: "registration 模組" {
  style.fill: "#e8f4e8"
  style.stroke: "#4a9a4a"

  list_use_case: "ListPendingApplicationsUseCase [Application / UseCase Interface]" {
    style.fill: "#fff8e6"
    style.stroke-dash: 5
  }

  review_use_case: "ReviewApplicationUseCase [Application / UseCase Interface]" {
    style.fill: "#fff8e6"
    style.stroke-dash: 5
  }

  app_service: "RegistrationApplicationService [Application]\n(實作兩個 UseCase interface)" {
    style.fill: "#fff8e6"
  }

  app_entity: "RegistrationApplication [Domain / Aggregate Root]\n狀態機: PENDING → APPROVED | REJECTED" {
    style.fill: "#f9f0ff"
    style.stroke-dash: 5
  }

  app_repo: "RegistrationApplicationRepository [Application / Port]" {
    style.fill: "#fff8e6"
    style.stroke-dash: 5
  }
}

db: "Database\n(registration_applications table)" {
  shape: cylinder
  style.fill: "#f5f5f5"
}

# 查詢流程
admin_actor -> admin_module.app_controller: "GET /admin/applications?status=PENDING\n[Bearer JWT]"
admin_module.app_controller -> registration_module.list_use_case: "listPending()"
registration_module.list_use_case -> registration_module.app_service: "(實作)"
registration_module.app_service -> registration_module.app_repo: "findAllByStatus(PENDING)"
registration_module.app_repo -> db: "JPA / JDBC"
registration_module.app_service -> admin_module.app_controller: "List<ApplicationSummary>"
admin_module.app_controller -> admin_actor: "200 OK [陣列]"

# 審核流程
admin_actor -> admin_module.app_controller: "PATCH /admin/applications/{id}/review\n{decision, reason} [Bearer JWT]"
admin_module.app_controller -> registration_module.review_use_case: "review(id, decision, reason, reviewerUsername)"
registration_module.review_use_case -> registration_module.app_service: "(實作)"
registration_module.app_service -> registration_module.app_repo: "findById(id)"
registration_module.app_service -> registration_module.app_entity: "approve(reviewedBy) / reject(reason, reviewedBy)"
registration_module.app_entity -> registration_module.app_repo: "save (狀態更新)"
registration_module.app_repo -> db: "JPA / JDBC"
registration_module.app_service -> admin_module.app_controller: "200 OK / 409 Conflict"
admin_module.app_controller -> admin_actor: "200 OK / 409 Conflict"
